# Application Configuration
PROJECT_NAME="TalentSphere"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres@localhost:5433/talentsphere"

# Security & JWT
SECRET_KEY="talentsphere-super-secure-production-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini AI API Key
GEMINI_API_KEY=""

# Upload Settings
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=["pdf", "docx", "txt"]

